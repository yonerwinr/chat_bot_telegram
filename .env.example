# ========================================================
# CONFIGURACIÓN DEL BOT DE MONITOREO DE TELEGRAM
# ========================================================

# 1. Credenciales de Telegram (Obtenlas gratis en https://my.telegram.org -> 'API development tools')
TELEGRAM_API_ID=tu_api_id_aqui
TELEGRAM_API_HASH=tu_api_hash_aqui

# 2. Canales a monitorear:
# Puedes colocar 1, 2 o los canales que quieras separados por comas.
# Acepta el @usuario (ej: canal_uno,canal_dos), enlaces t.me/canal o IDs numéricos (-100...)
TARGET_CHANNELS=canal_uno,canal_dos


# 3. Palabras o frases clave a buscar (separadas por comas):
# Ejemplo: urgente, bitcoin, oferta especial, 50%
# Si lo dejas vacío, te notificará de CUALQUIER mensaje que se publique en el canal
KEYWORDS=urgente,alerta,descuento

# 4. Modo de coincidencia:
# EXACT_MATCH=False -> Si el mensaje contiene CUALQUIERA de las palabras clave, avisa.
# EXACT_MATCH=True  -> Solo avisa si el mensaje es IDÉNTICO a alguna de las palabras clave.
EXACT_MATCH=False

# 5. Sensible a mayúsculas/minúsculas:
# CASE_SENSITIVE=False -> "URGENTE" y "urgente" coinciden igual.
CASE_SENSITIVE=False

# 6. Dónde quieres recibir la notificación:
# 'me' = En tus "Mensajes Guardados" de Telegram (recomendado y súper cómodo)
# O el @username de otra persona, o un ID de grupo/chat.
ALERT_DESTINATION=me

# 7. Horario de funcionamiento:
# Activo de Lunes a Viernes de 7:00 AM (07) a 8:00 PM (20). Fines de semana apagado.
SCHEDULE_ENABLED=True
START_HOUR=7
END_HOUR=20
# Zona horaria (opcional, si se deja vacío usa la hora de tu PC/servidor):
# Ejemplos: America/Caracas, America/Bogota, America/Mexico_City, America/Argentina/Buenos_Aires, Europe/Madrid
TIMEZONE=

# 8. (Opcional - Para Despliegue en la Nube tipo Koyeb/Render):

# Si se deja vacío, usará el archivo local 'session_telegram.session'.
# Para la nube, generas un StringSession con 'generar_sesion.py' y lo pegas aquí.
TELEGRAM_STRING_SESSION=
